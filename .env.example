# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for OAuth callbacks and API endpoints.
APP_URL="http://YOUR_VM_EXTERNAL_IP"

# PORT: The port the Node.js server will listen on (default: 3000).
PORT=3000

# ── MySQL / Cloud SQL Connection Settings ──────────────────────────────
# DB_HOST: Cloud SQL Private IP (from GCP Console > SQL > Overview > Private IP)
#          Use 127.0.0.1 if running MySQL locally for development.
DB_HOST="127.0.0.1"

# DB_PORT: MySQL port (default: 3306)
DB_PORT=3306

# DB_USER: The MySQL user you created (e.g. hr_app)
DB_USER="hr_app"

# DB_PASSWORD: The password you set for DB_USER
DB_PASSWORD="YOUR_STRONG_PASSWORD_HERE"

# DB_NAME: The MySQL database name (create this in Cloud SQL first)
DB_NAME="hr_system"
